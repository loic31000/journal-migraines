<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Ma tête aujourd'hui » : mêmes couleurs que l'appli (papier crème, encre aubergine) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:gravity="center_vertical"
        android:text="@string/widget_title"
        android:textColor="#2A1425"
        android:textSize="17sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/w_nopain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/widget_btn_dark"
        android:text="@string/widget_nopain"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_light"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:background="@drawable/widget_btn"
            android:text="@string/widget_light"
            android:textAllCaps="false"
            android:textColor="#2A1425"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/w_mid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:minHeight="48dp"
            android:background="@drawable/widget_btn"
            android:text="@string/widget_mid"
            android:textAllCaps="false"
            android:textColor="#2A1425"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/w_strong"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:minHeight="48dp"
            android:background="@drawable/widget_btn_strong"
            android:text="@string/widget_strong"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
